# Copy to .env for local use. Not needed for local dev by default: the app runs on
# src/ai/mock/ fixtures whenever `npm run dev` is used (see src/ai/client.ts, IS_MOCK_MODE).
# These only matter when running the real proxy locally (see docs/04-OPERATIONS/DEPLOYMENT.md)
# or when setting environment variables in the Vercel dashboard for a real deployment.

# Google AI Studio API key. Server-side only — never exposed to the browser.
GEMINI_API_KEY=

# Model id. A rolling alias, not a pinned version -- pinning to a dated model (e.g.
# gemini-2.5-flash) risks it being retired for new API keys without notice, which is exactly
# what happened during this project's own setup. Lite, not the full "flash-latest" alias: the
# free tier's daily-request cap measured as low as 20/day on regular Flash models during
# testing, versus 500/day on Lite for the same account -- check both on Google's rate-limit
# page, they can differ per account and change over time.
GEMINI_MODEL=gemini-flash-lite-latest

# Shared-key daily quota, set BELOW Google's actual free-tier limit (check it on Google's
# official rate-limit page before launch, per docs/04-OPERATIONS/ZERO-COST-INFRASTRUCTURE.md).
DAILY_GLOBAL_LIMIT=50
DAILY_IP_LIMIT=10

# The deployed origin, e.g. https://your-project.vercel.app. Requests from any other origin
# are rejected. Leave unset locally to skip the check.
ALLOWED_ORIGIN=

# A random string mixed into the IP hash so quota keys can never be reversed to a real address.
IP_HASH_SALT=

# Upstash Redis (free tier) REST credentials, used for the shared quota counters and kill switch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (optional cloud sync). Public client config, not secret -- see src/lib/firebase.ts.
# Get these from Firebase Console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
