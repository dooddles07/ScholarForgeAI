# Copy to .env for local use. Not needed for local dev by default: the app runs on
# src/ai/mock/ fixtures whenever `npm run dev` is used (see src/ai/client.ts, IS_MOCK_MODE).
# These only matter when running the real proxy locally (see docs/04-OPERATIONS/DEPLOYMENT.md)
# or when setting environment variables in the Vercel dashboard for a real deployment.

# Groq API key. Server-side only — never exposed to the browser.
GROQ_API_KEY=

# Model id. Only the gpt-oss models support the strict JSON schema this app's grounding rule
# depends on -- llama-3.3-70b, llama-3.1-8b, qwen3.6 and compound all reject the request
# outright, verified against the live API. Change this only to another model that supports
# structured outputs: https://console.groq.com/docs/structured-outputs#supported-models
GROQ_MODEL=openai/gpt-oss-120b

# Shared-key daily quota, set BELOW Groq's actual free-tier limit (1,000 requests/day at time of
# writing -- check the console before launch, per docs/04-OPERATIONS/ZERO-COST-INFRASTRUCTURE.md).
# Note the binding constraint is tokens-per-minute (8,000), not requests/day; that is what caps
# request size in api/generate.ts's MAX_CHARS, not these counters.
DAILY_GLOBAL_LIMIT=800
DAILY_IP_LIMIT=40

# The deployed origin, e.g. https://your-project.vercel.app. Requests from any other origin
# are rejected. Leave unset locally to skip the check.
ALLOWED_ORIGIN=

# A random string mixed into the IP hash so quota keys can never be reversed to a real address.
IP_HASH_SALT=

# Upstash Redis (free tier) REST credentials, used for the shared quota counters and kill switch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (optional cloud sync). Public client config, not secret -- see src/lib/firebase.ts.
# Get these from Firebase Console -> Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
