    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.12.1",
