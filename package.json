    "@radix-ui/react-tooltip": "^1.1.6",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.17.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
